{
  "type": 3,
  "name": "git-http",
  "title": "Git HTTP Server",
  "description": "A lightweight (Alpine) server that allows git requests over http/s to a specified repository folder. It serves repository contents to Git clients. It does nothing else. You get no web UI, accounts, issues or pull requests. Standard HTTP authentication can be configured manually but is not enabled by default.",
  "categories": [ "DevOps", "Servers" ],
  "platform": "linux", 
  "logo": "data:image/png;base64,",
  "note": "https://upload.wikimedia.org/wikipedia/commons/e/e0/Git-logo.svg",
  "notes": "",
  "env": [
    {
      "name": "CONTAINER_NAME",
      "label": "Container name",
      "default": "git-http",
      "description": "Container name (for docker, unlike 'Name' above which is only used by Portainer to manage displayed stacks)"
    },
    {
      "name": "PORT",
      "label": "Port",
      "description": "Port to use for the php server (check that it is not in use)",
      "default": "8999"
    },
    {
      "name": "REPO_ROOT",
      "label": "Repository folder",
      "default": "\"C:\\\\Users\\\\Admin\\\\Documents\\\\Docker\\\\Projects\\\\Project Name\\\\app\"",
      "description": "Path on host to use for the Git repository to serve. For Windows, enclose in quotes and escape path separators with double-backslashes."
    },
    {
      "name": "RESTART",
      "label": "Restart",
      "description": "Restart behavior (on failure or Docker engine restart)",
      "select": [
            {
              "text": "Always restart",
              "value": "always"
            },
            {
              "text": "Restart unless stopped",
              "value": "unless-stopped",
              "default": true
            },
            {
              "text": "Restart on failure",
              "value": "on-failure"
            },
            {
              "text": "No restart",
              "value": "no"
            }            
      ]          
    }
  ],
  "repository": {
    "url": "https://github.com/Mugane/Portainer",
    "stackfile": "templates/git-http/docker-compose.yml"
  }
}
