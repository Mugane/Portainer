{
  "type": 3,
  "name": "git-http",
  "title": "Git HTTP Server",
  "description": "A lightweight (Alpine) server that answers git clone requests over http/s to a specified repository folder. It serves repository contents to Git clients. It does nothing else. You get no web UI, accounts, issues, or pull requests (unless you configure HTTP authentication manually).",
  "categories": [ "DevOps", "Servers" ],
  "platform": "linux",
  "env": [
    {
      "name": "CONTAINER_NAME",
      "label": "Container name",
      "default": "git-http",
      "description": "Container name (for docker, unlike 'Name' above which is only used by Portainer to manage displayed stacks)"
    },
    {
      "name": "PORT",
      "label": "Port",
      "description": "Port to use for the php server (check that it is not in use)",
      "default": "8999"
    },
    {
      "name": "REPO_ROOT",
      "label": "Repository folder",
      "default": "",
      "description": "Path on host to use for the Git repository to serve. For Windows, escape path separators as double-backslashes (e.g. C:\\\\Docker\\\\app\\\\data ). For Linux, use only full paths, (e.g. /home/user/app/data ). If the path contains spaces, enclose in double-quotes."
    },
    {
      "name": "RESTART",
      "label": "Restart",
      "description": "Restart behavior (on failure or Docker engine restart)",
      "select": [
            {
              "text": "Always restart",
              "value": "always"
            },
            {
              "text": "Restart unless stopped",
              "value": "unless-stopped",
              "default": true
            },
            {
              "text": "Restart on failure",
              "value": "on-failure"
            },
            {
              "text": "No restart",
              "value": "no"
            }            
      ]          
    }
  ],
  "repository": {
    "url": "https://github.com/Mugane/Portainer",
    "stackfile": "templates/git-http/docker-compose.yml"
  },
  "logo": "data:image/png;base64,"
}
